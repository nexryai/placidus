# HTTP and Mirakurun
PLACIDUS_LISTEN=:40773
PLACIDUS_MIRAKURUN_URL=http://127.0.0.1:40772

# Persistent data and original MPEG-TS recordings
PLACIDUS_DATA_DIR=./data
PLACIDUS_RECORDING_DIR=./data/recordings

# FFmpeg hardware-first transcoding
PLACIDUS_FFMPEG=ffmpeg
PLACIDUS_ENCODER=auto

# Capacity and recording margins
PLACIDUS_TUNER_LIMIT=1
PLACIDUS_RECORDING_MARGIN=0s
