{{define "styles"}}
<style>
:root{color-scheme:dark;--bg:#0f0f0f;--panel:#181818;--panel2:#242424;--line:#343434;--text:#f1f1f1;--muted:#aaa;--accent:#ff385c;--accent2:#ff0033;--warn:#ffca4b;--danger:#ff6b6b;--ok:#53d38a;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text)}body{padding-top:64px}a{color:inherit;text-decoration:none}button,input{font:inherit}button{cursor:pointer}.topbar{position:fixed;inset:0 0 auto 0;height:64px;z-index:20;display:flex;align-items:center;gap:24px;padding:0 24px;background:rgba(15,15,15,.94);backdrop-filter:blur(14px);border-bottom:1px solid #222}.brand{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:800;letter-spacing:-.5px}.brand-mark{display:grid;place-items:center;width:34px;height:24px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent2));font-size:12px}.top-status{margin-left:auto;display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}.dot{width:8px;height:8px;border-radius:50%;background:var(--ok)}.dot.warn{background:var(--warn)}.rail{position:fixed;top:64px;bottom:0;left:0;width:92px;padding:18px 10px;background:var(--bg);z-index:10}.rail a{display:flex;min-height:62px;margin:4px 0;padding:10px 4px;flex-direction:column;align-items:center;justify-content:center;gap:6px;border-radius:12px;color:var(--muted);font-size:11px}.rail a:hover,.rail a.active{background:var(--panel2);color:var(--text)}.rail-icon{font-size:20px}.page{max-width:1600px;margin:0 auto;padding:30px 34px 60px 126px}.page-head{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:24px}.eyebrow{margin:0 0 6px;color:var(--accent);font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1.5px}h1,h2,h3,p{margin-top:0}h1{margin-bottom:0;font-size:30px;letter-spacing:-.7px}h2{margin:32px 0 16px;font-size:22px}h3{margin-bottom:8px}.muted{color:var(--muted)}.notice{margin:0 0 20px;padding:14px 16px;border:1px solid #725f19;border-radius:12px;background:#2b2718;color:#ffe49a}.notice.error{border-color:#743434;background:#301b1b;color:#ffb4b4}.notice.success{border-color:#286342;background:#172b21;color:#aef0c8}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:24px 18px}.card{min-width:0}.thumb{position:relative;display:flex;aspect-ratio:16/9;align-items:flex-end;overflow:hidden;padding:18px;border-radius:14px;background:radial-gradient(circle at 80% 20%,rgba(255,56,92,.35),transparent 32%),linear-gradient(145deg,#393939,#171717);transition:transform .18s ease}.thumb:hover{transform:translateY(-2px)}.channel-badge{position:absolute;left:14px;top:14px;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff;color:#111;font-size:15px;font-weight:900}.live-pill{position:absolute;right:10px;bottom:10px;padding:4px 7px;border-radius:5px;background:var(--accent2);font-size:11px;font-weight:800}.thumb-title{max-width:80%;font-size:17px;font-weight:750;text-shadow:0 2px 12px #000}.card-meta{display:flex;gap:12px;padding:12px 4px}.card-meta .avatar{flex:0 0 36px;height:36px;display:grid;place-items:center;border-radius:50%;background:var(--panel2);font-weight:800}.card-title{margin:0 0 4px;font-size:15px;line-height:1.35}.card-sub{color:var(--muted);font-size:13px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:0 16px;border:0;border-radius:20px;background:var(--text);color:#111;font-weight:750}.button:hover{filter:brightness(.88)}.button.secondary{background:var(--panel2);color:var(--text)}.button.danger{background:#432020;color:#ffbaba}.button.small{min-height:32px;padding:0 12px;font-size:12px}.guide{display:flex;flex-direction:column;gap:12px}.guide-row{display:grid;grid-template-columns:190px 1fr;gap:12px;padding:12px;border-radius:14px;background:var(--panel)}.guide-channel{display:flex;align-items:center;gap:12px;font-weight:750}.guide-programs{display:flex;gap:10px;overflow-x:auto}.program{flex:0 0 260px;padding:12px;border:1px solid var(--line);border-radius:10px;background:#202020}.program.current{border-color:var(--accent);background:#291a1e}.program-time{color:var(--muted);font-size:12px}.program p{margin:6px 0;font-size:14px}.player-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:28px}.player-shell{overflow:hidden;aspect-ratio:16/9;border-radius:14px;background:#000;box-shadow:0 14px 50px rgba(0,0,0,.35)}video{width:100%;height:100%;background:#000}.player-title{margin:18px 0 4px}.channel-list{display:flex;flex-direction:column;gap:8px;max-height:75vh;overflow:auto}.channel-item{display:grid;grid-template-columns:42px 1fr;gap:10px;padding:9px;border-radius:10px}.channel-item:hover,.channel-item.active{background:var(--panel2)}.channel-logo{display:grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#eee;color:#111;font-weight:900}.channel-item p{margin:1px 0;font-size:13px}.channel-item small{color:var(--muted)}.reservation-list{display:flex;flex-direction:column;gap:12px}.reservation{display:grid;grid-template-columns:110px minmax(0,1fr) auto;gap:20px;align-items:center;padding:18px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.state{display:inline-flex;justify-content:center;padding:6px 9px;border-radius:20px;background:#333;color:var(--muted);font-size:11px;font-weight:800;text-transform:uppercase}.state-recording{background:#5a1420;color:#ffb1bd}.state-completed{background:#173828;color:#9be2ba}.state-failed{background:#3f2020;color:#ffaaaa}.state-cancelled{opacity:.65}.empty{padding:50px 20px;border:1px dashed var(--line);border-radius:14px;text-align:center;color:var(--muted)}.system-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}.system-card{padding:18px;border-radius:14px;background:var(--panel)}.system-card strong{display:block;margin-bottom:5px}.system-card span{font-size:13px;color:var(--muted)}
@media(max-width:900px){.player-layout{grid-template-columns:1fr}.channel-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));max-height:none}.guide-row{grid-template-columns:1fr}.reservation{grid-template-columns:1fr}.page{padding-left:112px}}
@media(max-width:620px){body{padding-top:56px}.topbar{height:56px;padding:0 14px}.top-status{display:none}.rail{top:auto;bottom:0;width:100%;height:64px;padding:4px 8px;display:grid;grid-template-columns:repeat(3,1fr);background:rgba(15,15,15,.97);border-top:1px solid #282828}.rail a{min-height:54px;margin:0;flex-direction:row;font-size:12px}.rail-icon{font-size:18px}.page{padding:22px 14px 90px}.page-head{align-items:start;flex-direction:column}.cards{grid-template-columns:1fr 1fr;gap:18px 10px}.thumb{border-radius:9px;padding:10px}.channel-badge{left:8px;top:8px;width:34px;height:34px}.thumb-title{font-size:14px}.card-meta .avatar{display:none}.card-meta{padding:8px 2px}.guide-row{padding:8px}.program{flex-basis:230px}.player-shell{margin:0 -14px;border-radius:0}.player-layout{gap:18px}}
@media(max-width:420px){.cards{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
{{end}}

{{define "chrome"}}
<header class="topbar">
  <a class="brand" href="/"><span class="brand-mark">▶</span><span>placidus</span></a>
  <div class="top-status"><span class="dot {{if ge .Recording.Occupied .Recording.Limit}}warn{{end}}"></span>{{if gt .Recording.Occupied 0}}{{.Recording.Occupied}} tuner service(s) recording{{else}}Ready for live TV{{end}}</div>
</header>
<nav class="rail" aria-label="Primary navigation">
  <a href="/" class="{{if eq .Active "home"}}active{{end}}"><span class="rail-icon">⌂</span>Home</a>
  <a href="/" class="{{if eq .Active "live"}}active{{end}}"><span class="rail-icon">▶</span>Live</a>
  <a href="/reservations" class="{{if eq .Active "reservations"}}active{{end}}"><span class="rail-icon">◷</span>Library</a>
</nav>
{{end}}
