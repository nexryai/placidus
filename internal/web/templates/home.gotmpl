{{define "home"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Page.Title}} · placidus</title>{{template "styles"}}</head>
<body>{{template "chrome" .Page}}<main class="page">
  <div class="page-head"><div><p class="eyebrow">Your television</p><h1>On air now</h1></div><a class="button secondary" href="#guide">Program guide</a></div>
  {{if .Page.Message}}<div class="notice success" role="status">{{.Page.Message}}</div>{{end}}
  {{if .BackendError}}<div class="notice error" role="alert"><strong>Mirakurun is unavailable.</strong> {{.BackendError}}</div>{{end}}
  {{if .Capabilities.Warning}}<div class="notice" role="status"><strong>Encoding notice.</strong> {{.Capabilities.Warning}}</div>{{end}}
  {{if gt .Page.Recording.Occupied 0}}<div class="notice" role="status"><strong>Recording has priority.</strong> When all tuners are occupied, only a service already being recorded can be watched.</div>{{end}}
  <section class="cards" aria-label="Current programs">
    {{range .Services}}{{if .Current}}<article class="card">
      <a class="thumb" href="/live/{{.ID}}"><span class="channel-badge">{{if .Number}}{{.Number}}{{else}}TV{{end}}</span><span class="thumb-title">{{.Current.Name}}</span><span class="live-pill">LIVE</span></a>
      <div class="card-meta"><div class="avatar">{{if .Number}}{{.Number}}{{else}}TV{{end}}</div><div><h3 class="card-title"><a href="/live/{{.ID}}">{{.Current.Name}}</a></h3><div class="card-sub">{{.Name}} · until {{clock .Current.EndAt}}</div></div></div>
    </article>{{end}}{{else}}<div class="empty">No services are available from Mirakurun.</div>{{end}}
  </section>
  <h2 id="guide">Program guide</h2>
  <section class="guide" aria-label="Program guide">
  {{range .Services}}<article class="guide-row"><div class="guide-channel"><span class="channel-logo">{{if .Number}}{{.Number}}{{else}}TV{{end}}</span><div>{{.Name}}<div class="muted">{{.Type}}</div></div></div><div class="guide-programs">
    {{range .Programs}}<div class="program"><div class="program-time">{{clock .StartAt}}–{{clock .EndAt}}</div><p><strong>{{.Name}}</strong></p><form method="post" action="/reservations"><input type="hidden" name="program_id" value="{{.ID}}"><button class="button secondary small" type="submit">Reserve</button></form></div>{{else}}<div class="program muted">No upcoming EPG data</div>{{end}}
  </div></article>{{end}}
  </section>
  <h2>System</h2><section class="system-grid">
    <div class="system-card"><strong>Mirakurun</strong><span>{{if .BackendError}}Disconnected{{else}}Connected · {{len .Services}} services{{end}}</span></div>
    <div class="system-card"><strong>FFmpeg</strong><span>{{if .Capabilities.Available}}{{.Capabilities.Selected.Name}} · {{if .Capabilities.Selected.Hardware}}hardware{{else}}software{{end}}{{else}}Unavailable{{end}}</span></div>
    <div class="system-card"><strong>Recording capacity</strong><span>{{.Page.Recording.Occupied}} of {{.Page.Recording.Limit}} configured tuner services occupied</span></div>
  </section>
</main></body></html>{{end}}
