{{define "reservations"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Page.Title}} · placidus</title>{{template "styles"}}</head>
<body>{{template "chrome" .Page}}<main class="page">
  <div class="page-head"><div><p class="eyebrow">Library</p><h1>Reservations & recordings</h1></div><a class="button secondary" href="/">Browse guide</a></div>
  {{if .Page.Message}}<div class="notice success" role="status">{{.Page.Message}}</div>{{end}}{{if .Page.Error}}<div class="notice error" role="alert">{{.Page.Error}}</div>{{end}}
  {{if gt .Page.Recording.Occupied 0}}<div class="notice" role="status">Recording is using tuner capacity. Live viewing is limited to services already being recorded when all tuners are occupied.</div>{{end}}
  <section class="reservation-list">{{range .Reservations}}<article class="reservation"><span class="state {{stateClass .State}}">{{.State}}</span><div><h3>{{.Title}}</h3><p class="muted">{{dateTime .StartAt}}–{{clock .EndAt}} · {{duration (.EndAt.Sub .StartAt)}}</p>{{if .Error}}<p class="notice error">{{.Error}}</p>{{end}}</div><div class="actions">
    {{if eq .State "completed"}}<a class="button secondary small" href="/recordings/{{.ID}}/file">Play / download</a>{{end}}
    {{if or (eq .State "scheduled") (eq .State "recording")}}<form method="post" action="/reservations/{{.ID}}/cancel"><button class="button danger small" type="submit">Cancel</button></form>{{end}}
  </div></article>{{else}}<div class="empty"><h3>No reservations yet</h3><p>Choose a program from the guide to schedule a recording.</p></div>{{end}}</section>
</main></body></html>{{end}}
